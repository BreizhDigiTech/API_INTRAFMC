# Production Environment Configuration
APP_ENV=production
APP_DEBUG=false
APP_URL=https://yourdomain.com

# Database Configuration
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=api_intrafmc_prod
DB_USERNAME=your_db_user
DB_PASSWORD=your_secure_password

# JWT Configuration
JWT_SECRET=your_extremely_secure_jwt_secret_key_here
JWT_TTL=60
JWT_REFRESH_TTL=20160

# Cache Configuration (Redis recommended for production)
CACHE_DRIVER=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

# Redis Configuration
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=your_redis_password
REDIS_PORT=6379

# GraphQL Security Settings
LIGHTHOUSE_SECURITY_DISABLE_INTROSPECTION=true
LIGHTHOUSE_MAX_QUERY_COMPLEXITY=1000
LIGHTHOUSE_MAX_QUERY_DEPTH=10
LIGHTHOUSE_SCHEMA_CACHE_ENABLE=true

# Mail Configuration
MAIL_MAILER=smtp
MAIL_HOST=your_smtp_host
MAIL_PORT=587
MAIL_USERNAME=your_email
MAIL_PASSWORD=your_email_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@yourdomain.com
MAIL_FROM_NAME="${APP_NAME}"

# Logging Configuration
LOG_CHANNEL=daily
LOG_LEVEL=warning

# Session Configuration
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=strict

# File Upload Limits
UPLOAD_MAX_FILESIZE=2M
POST_MAX_SIZE=8M

# CORS Configuration (adjust for your frontend domain)
SANCTUM_STATEFUL_DOMAINS=yourdomain.com
